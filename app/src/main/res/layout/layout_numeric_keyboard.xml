<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:layout_gravity="center_horizontal"
    android:layout_marginTop="4dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_key_1"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:text="1"
            android:textSize="18sp"
            android:textStyle="normal"
            android:textColor="@color/primary_blue_dark"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:rippleColor="@color/primary_blue_light" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_key_2"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:text="2"
            android:textSize="18sp"
            android:textStyle="normal"
            android:textColor="@color/primary_blue_dark"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:rippleColor="@color/primary_blue_light" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_key_3"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:text="3"
            android:textSize="18sp"
            android:textStyle="normal"
            android:textColor="@color/primary_blue_dark"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:rippleColor="@color/primary_blue_light" />
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_key_4"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:text="4"
            android:textSize="18sp"
            android:textStyle="normal"
            android:textColor="@color/primary_blue_dark"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:rippleColor="@color/primary_blue_light" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_key_5"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:text="5"
            android:textSize="18sp"
            android:textStyle="normal"
            android:textColor="@color/primary_blue_dark"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:rippleColor="@color/primary_blue_light" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_key_6"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:text="6"
            android:textSize="18sp"
            android:textStyle="normal"
            android:textColor="@color/primary_blue_dark"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:rippleColor="@color/primary_blue_light" />
    </LinearLayout>

    <!-- Row 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_key_7"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:text="7"
            android:textSize="18sp"
            android:textStyle="normal"
            android:textColor="@color/primary_blue_dark"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:rippleColor="@color/primary_blue_light" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_key_8"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:text="8"
            android:textSize="18sp"
            android:textStyle="normal"
            android:textColor="@color/primary_blue_dark"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:rippleColor="@color/primary_blue_light" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_key_9"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:text="9"
            android:textSize="18sp"
            android:textStyle="normal"
            android:textColor="@color/primary_blue_dark"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:rippleColor="@color/primary_blue_light" />
    </LinearLayout>

    <!-- Row 4 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_key_clear"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            app:icon="@drawable/ic_clear"
            app:iconTint="#E53935"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            android:gravity="center"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:rippleColor="#FFEBEE" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_key_0"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            android:text="0"
            android:textSize="18sp"
            android:textStyle="normal"
            android:textColor="@color/primary_blue_dark"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:rippleColor="@color/primary_blue_light" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_key_del"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="1dp"
            app:icon="@drawable/ic_backspace"
            app:iconTint="@color/primary_blue_dark"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            android:gravity="center"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:rippleColor="@color/primary_blue_light" />
    </LinearLayout>

</LinearLayout>
