<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Header Layout (Logo) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="24dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_bank_logo"
            android:layout_width="120dp"
            android:layout_height="45dp"
            android:contentDescription="Bank Logo"
            android:src="@drawable/vak"
            android:scaleType="fitStart"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Powered By Footer (hidden by default, shown only on Home screen) -->
    <LinearLayout
        android:id="@+id/powered_by_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/powered_by"
            android:textColor="@color/primary_blue_dark"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:adjustViewBounds="true"
            android:src="@drawable/wave_groove"
            android:scaleType="fitCenter"
            android:contentDescription="Wave Groove Logo" />

    </LinearLayout>

    <!-- Decorative Plant (Rendered relative to parent bottom/right) -->
    <ImageView
        android:id="@+id/iv_plant"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="12dp"
        android:contentDescription="Decorative Plant"
        android:src="@drawable/ic_plant_new"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</merge>
