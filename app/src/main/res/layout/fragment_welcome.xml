<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_kiosk">

    <!-- Common Background Elements (Plant and Powered By) -->
    <include layout="@layout/kiosk_background" />



    <!-- Main Content Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/powered_by_layout"
        app:layout_constraintTop_toBottomOf="@id/header_layout">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_title"
            android:textColor="@color/primary_blue_dark"
            android:textSize="28sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <!-- Subtitle -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/select_service"
            android:textColor="#5D6D7E"
            android:textSize="15sp"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.03" />

        <!-- 3 Cards Container -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <!-- Card 1: Account Opening -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_account_opening"
                android:layout_width="@dimen/welcome_card_width"
                android:layout_height="@dimen/welcome_card_height"
                android:layout_margin="10dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_welcome_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="@dimen/welcome_card_icon_size"
                        android:layout_height="@dimen/welcome_card_icon_size"
                        android:src="@drawable/ic_account_opening" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/account_opening"
                        android:textColor="@color/primary_blue_dark"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Card 2: Cheque Deposit -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_cheque_deposit"
                android:layout_width="@dimen/welcome_card_width"
                android:layout_height="@dimen/welcome_card_height"
                android:layout_margin="10dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_welcome_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="@dimen/welcome_card_icon_size"
                        android:layout_height="@dimen/welcome_card_icon_size"
                        android:src="@drawable/ic_cheque" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/cheque_deposit"
                        android:textColor="@color/primary_blue_dark"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Card 3: QR Code Generator -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_qr_code_generator"
                android:layout_width="@dimen/welcome_card_width"
                android:layout_height="@dimen/welcome_card_height"
                android:layout_margin="10dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_welcome_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="@dimen/welcome_card_icon_size"
                        android:layout_height="@dimen/welcome_card_icon_size"
                        android:src="@drawable/ic_qr_code" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/qr_code_generator"
                        android:textColor="@color/primary_blue_dark"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Card 4: Home -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_home"
                android:layout_width="@dimen/welcome_card_width"
                android:layout_height="@dimen/welcome_card_height"
                android:layout_margin="10dp"
                android:clickable="true"
                android:focusable="true"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_welcome_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="@dimen/welcome_card_icon_size"
                        android:layout_height="@dimen/welcome_card_icon_size"
                        android:src="@drawable/ic_home" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/home"
                        android:textColor="@color/primary_blue_dark"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </LinearLayout>

    <!-- Powered By Footer -->


</androidx.constraintlayout.widget.ConstraintLayout>
