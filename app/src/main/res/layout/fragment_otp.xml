<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_kiosk">

    <!-- Common Background Elements (Plant and Powered By) -->
    <include layout="@layout/kiosk_background" />



    <!-- Content Card Area -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.7"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.6"
        app:cardCornerRadius="24dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintBottom_toTopOf="@id/bottom_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="0dp">

            <!-- Left Column: OTP details & input boxes -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/enter_otp"
                    android:textColor="@color/primary_blue_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:text="@string/enter_otp_desc"
                    android:textColor="@color/grey_text"
                    android:textSize="11sp" />

                <!-- OTP Digit Input Row -->
                <LinearLayout
                    android:id="@+id/ll_otp_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/et_otp_1"
                        android:layout_width="28dp"
                        android:layout_height="38dp"
                        android:layout_marginHorizontal="2dp"
                        android:background="@drawable/bg_otp_box"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:maxLines="1"
                        android:textColor="@color/primary_blue_dark"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:ignore="LabelFor" />

                    <EditText
                        android:id="@+id/et_otp_2"
                        android:layout_width="28dp"
                        android:layout_height="38dp"
                        android:layout_marginHorizontal="2dp"
                        android:background="@drawable/bg_otp_box"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:maxLines="1"
                        android:textColor="@color/primary_blue_dark"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:ignore="LabelFor" />

                    <EditText
                        android:id="@+id/et_otp_3"
                        android:layout_width="28dp"
                        android:layout_height="38dp"
                        android:layout_marginHorizontal="2dp"
                        android:background="@drawable/bg_otp_box"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:maxLines="1"
                        android:textColor="@color/primary_blue_dark"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:ignore="LabelFor" />

                    <EditText
                        android:id="@+id/et_otp_4"
                        android:layout_width="28dp"
                        android:layout_height="38dp"
                        android:layout_marginHorizontal="2dp"
                        android:background="@drawable/bg_otp_box"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:maxLines="1"
                        android:textColor="@color/primary_blue_dark"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:ignore="LabelFor" />

                    <EditText
                        android:id="@+id/et_otp_5"
                        android:layout_width="28dp"
                        android:layout_height="38dp"
                        android:layout_marginHorizontal="2dp"
                        android:background="@drawable/bg_otp_box"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:maxLines="1"
                        android:textColor="@color/primary_blue_dark"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:ignore="LabelFor" />

                    <EditText
                        android:id="@+id/et_otp_6"
                        android:layout_width="28dp"
                        android:layout_height="38dp"
                        android:layout_marginHorizontal="2dp"
                        android:background="@drawable/bg_otp_box"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="1"
                        android:maxLines="1"
                        android:textColor="@color/primary_blue_dark"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:ignore="LabelFor" />

                </LinearLayout>

                <!-- Resend Timer -->
                <TextView
                    android:id="@+id/tv_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/resend_timer_prefix"
                    android:textColor="@color/grey_text"
                    android:textSize="12sp" />



            </LinearLayout>

            <!-- Right Column: Custom Keypad -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <include
                    android:id="@+id/keyboard_container"
                    layout="@layout/layout_numeric_keyboard" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Bottom Bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back Button: navigates back to Aadhaar screen -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_previous"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:paddingHorizontal="8dp"
            android:text="@string/home"
            android:textColor="@color/primary_blue"
            android:textSize="15sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_home"
            app:iconTint="@color/primary_blue"
            app:iconGravity="textStart"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/primary_blue"
            app:strokeWidth="1.5dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:paddingHorizontal="8dp"
            android:text="@string/submit"
            android:textColor="@color/primary_blue"
            android:textSize="15sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:strokeColor="@color/primary_blue"
            app:strokeWidth="1.5dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
